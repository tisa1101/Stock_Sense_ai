# ==============================================================================
# StockSense Global Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MS SQL Server 2022)
# ------------------------------------------------------------------------------
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!

# Local development connection string (LocalDB):
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=StockSenseDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Docker container connection string:
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=StockSenseDb;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=StockSense_Super_Secret_JWT_Key_2026_Hackathon_Production_Grade_Secret!
Jwt__Key=StockSense_Super_Secret_JWT_Key_2026_Hackathon_Production_Grade_Secret!
Jwt__Issuer=StockSenseAPI
Jwt__Audience=StockSenseClient

# ------------------------------------------------------------------------------
# 3. AI Intelligence Microservice (Python FastAPI + Google Gemini)
# ------------------------------------------------------------------------------
AiService__BaseUrl=http://ai-service:8000
DATABASE_URL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=sqlserver,1433;DATABASE=StockSenseDb;UID=sa;PWD=YourStrong@Passw0rd!;TrustServerCertificate=yes;
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Frontend Application (React + Vite)
# ------------------------------------------------------------------------------
# In Docker (Nginx reverse proxy), relative /api is used. For standalone dev:
VITE_API_URL=http://localhost:5000/api
